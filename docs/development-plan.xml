        <fn-get_settings PURPOSE="Кэшированный доступ к синглтону Settings" />
      </interface>
      <depends>—</depends>
      <target><source>task1-currency-web/app/config.py</source><tests>task1-currency-web/tests/unit/test_config.py</tests></target>
