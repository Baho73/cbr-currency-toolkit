        <outputs><param name="snapshot" type="RatesSnapshot" /></outputs>
        <errors><error code="CbrUnavailableError" /><error code="CbrResponseError" /></errors>
      </contract>
      <interface>
        <class-RatesCache PURPOSE="метод get_snapshot(): отдаёт кэш в пределах TTL, иначе обновляет; защищён asyncio.Lock" />
      </interface>
      <depends>M-T1-CBR-CLIENT, M-T1-CONFIG</depends>
      <target><source>task1-currency-web/app/cache.py</source><tests>task1-currency-web/tests/unit/test_cache.py</tests></target>
      <observability><log-prefix>[RatesCache]</log-prefix><critical-block>BLOCK_REFRESH_IF_STALE</critical-block></observability>
      <verification-ref>V-M-T1-CACHE</verification-ref>
      <notes><note-1>При конкурентных запросах обновление выполняется один раз (single-flight через Lock).</note-1></notes>
    </M-T1-CACHE>

