<KnowledgeGraph>
  <Project NAME="Тестовое задание: утилиты курсов валют ЦБ РФ" VERSION="0.2.0">
    <keywords>курсы валют, ЦБ РФ, cbr-xml-daily, конвертер валют, FastAPI, async, httpx, asyncio, Docker, Google Apps Script, UrlFetchApp, REST API, retry, TTL-кэш</keywords>
    <annotation>Монорепозиторий из трёх независимых самодостаточных утилит вокруг публичного API курсов валют ЦБ РФ. Три проекта не имеют кросс-задачных зависимостей.</annotation>

